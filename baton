#!/usr/bin/env bash
# baton -- multi-account Claude Code launcher with liveness detection.
#
# Why: subscription usage is metered per account server-side; nothing can pool
# two plans into one. What CAN be local is which account a session launches
# under. Each account = one dir under ~/.claude-accounts/<name> used as
# CLAUDE_CONFIG_DIR. "a" is a symlink to ~/.claude (the primary account);
# every other account symlinks the harness (CLAUDE.md, settings, skills,
# hooks, projects, state...) back into ~/.claude and keeps only its own
# credentials and .claude.json, so all accounts run one harness and can
# resume each other's sessions.
#
# Selection, in order:
#   1. drop accounts marked dead (limit hit; marks expire automatically)
#   2. rank the rest by launches/weight (weight = <account>/.weight, default 1;
#      give bigger plans a larger number so they absorb more launches)
#   3. PROBE the top candidate: a tiny headless `claude -p` under its config
#      dir. The CLI itself answers with one of a closed set of outcomes:
#        ALIVE   got a reply -> launch it (result cached 15 min)
#        LIMIT   "hit your ... limit / resets <time>" -> mark dead until the
#                parsed reset time (5h fallback), try the next account
#        AUTH    "Not logged in" -> mark dead 1h with a loud warning, try next
#        UNKNOWN anything else (network down etc) -> warn and launch anyway,
#                because an outage affects every account equally
#      The partition is total on purpose: no outcome falls through silently.
#   Exact remaining-percentage ranking would need each account's OAuth token
#   (api.anthropic.com/api/oauth/usage); deliberately not implemented -- this
#   script never touches credentials. The probe asks the CLI instead.
#
# Probe side effects, accepted and bounded: each probe costs a few tokens on
# the probed account and writes one tiny session transcript, kept out of real
# project history by running from ~/.claude-accounts/.probe. SessionStart
# hooks fire on probes too; probe rows are identifiable by that cwd.
#
# Usage:
#   baton [claude args...]        auto-pick live account, launch claude
#   baton <account> [args...]     force that account (no probe, warns if dead)
#   baton --next [args...]        mark last-used account dead 5h, then auto-pick
#   baton --fast [args...]        auto-pick without probing
#   baton --add <name>            create a new account dir (then: baton <name>,
#                               /login in the session that opens)
#   baton --dead [name] [dur]     mark account dead (default: last-used, 5h;
#                               dur like 90m / 5h / 3d)
#   baton --revive <name>         clear a dead mark
#   baton --probe <name>          probe one account, print the class, apply marks
#   baton --status                accounts, weights, tallies, dead-until, last
#   baton --pick                  print auto-pick choice (dead-filter + tally
#                               only; does NOT probe)
#   baton --reset                 zero tallies
#   baton --lock-status <subject>   what the lock root says about one subject
#                               (free / held / stale-dead / stale-foreign /
#                               could-not-inspect) and how many subjects it
#                               managed to inspect. Exit 0 free-or-reclaimable,
#                               1 held, 2 could-not-inspect (never a pass).
#   baton --claim <subject> -- <cmd...>   run cmd while holding the lock on
#                               that subject; refuse, naming the holding pid,
#                               if a live owner already has it. Subjects are
#                               namespaced text: session:<id>, unit:<name>,
#                               login:<account>.
#   baton --redispatch <unit> -- <cmd...>  redo a run unit rather than adopt
#                               it: claim it, kill the matched orphan, CONFIRM
#                               it is gone by re-probing, and only then launch
#                               the replacement.
#   baton --night [claude args...]  unattended mode: auto-pick like plain
#                               baton, but watch the live transcript for a
#                               limit/auth hit and hand off to the next
#                               account instead of stopping. See
#                               features/failover.feature for the full spec.
#
# State lives in ~/.claude-accounts: .tally, .last, .dead/<name>
# ("until-epoch reason"), .alive/<name> (mtime = last ALIVE probe). Two
# simultaneous launches can race the tally rewrite; worst case one launch
# goes uncounted, which the ratio absorbs on the next pick.
#
# Env overrides (all optional, all no-ops on default behavior when unset):
#   BATON_ACCOUNTS_ROOT      accounts root (default: $HOME/.claude-accounts)
#   BATON_EXCLUDE            account name auto-pick must skip (any mode)
#   BATON_WATCH_INTERVAL     --night poll interval, seconds (default: 5)
#   BATON_MAX_HANDOFFS       --night handoff cap per run (default: 3)
#   BATON_SESSION_WAIT_SECS  accepted and validated, but no longer changes
#                            behavior: --night now watches every transcript
#                            for GROWTH rather than waiting for a new file to
#                            appear, so there is nothing left to wait for
#                            (default: 30; see failover.feature D6)
#
# Implementation lives in lib/: detect.sh (pure text classification, shared
# by probe() and the --night watcher so they can't drift), accounts.sh
# (state + selection + probing), watch.sh (--night's child-process control).

set -u
# lib/ sits beside the REAL script, so a symlink on PATH must be followed to
# its target before dirname; readlink is looped because a link can point at
# a link, and a relative link target is relative to the link's own dir.
SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
while [ -L "$SCRIPT_PATH" ]; do
  _link=$(readlink "$SCRIPT_PATH")
  case "$_link" in
    /*) SCRIPT_PATH="$_link" ;;
    *)  SCRIPT_PATH="$(dirname "$SCRIPT_PATH")/$_link" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

die() { echo "baton: $*" >&2; exit 1; }
warn() { echo "baton: $*" >&2; }
now() { date +%s; }

. "$SCRIPT_DIR/lib/detect.sh"
. "$SCRIPT_DIR/lib/accounts.sh"
# watch.sh is sourced ONLY by the --night branch below (QA-DOC section 4 rule
# 5: existing flags depend on accounts, never on watch). It defines functions
# and nothing else, so sourcing it at dispatch time -- one statement before
# the single call site -- is as safe as sourcing it here, and makes the rule
# true of the running program rather than only of the prose.

# Harness pieces a non-primary account shares with ~/.claude. Credentials and
# .claude.json stay per-account; everything else is one fleet.
LINKS="CLAUDE.md MISSION.md settings.json settings.local.json skills hooks agents plugins projects state history.jsonl lib scripts bin agent-memory sessions tasks context-mode comms reminders"

mkdir -p "$ROOT"

# The glob that defines "an account" lives in lib/accounts.sh with the two
# functions that read the array (is_account, ranked), not here.
enumerate_accounts

# bash 3.2 (macOS default) errors on "${accounts[@]}" for an EMPTY array under
# set -u, so refuse everything except --add before any expansion is reached.
if [ ${#accounts[@]} -eq 0 ]; then
  case "${1:-}" in --add) : ;; *) die "no accounts under $ROOT; run: baton --add <name>" ;; esac
fi

case "${1:-}" in
  --status)
    last=$(cat "$LAST" 2>/dev/null || echo "-")
    printf "%-10s %-7s %-9s %-22s %s\n" ACCOUNT WEIGHT LAUNCHES DEAD-UNTIL LAST
    for a in "${accounts[@]}"; do
      c=$(count_of "$a"); mark=""; du="-"
      [ "$a" = "$last" ] && mark="<- last"
      if is_dead "$a"; then
        du="$(date -r "$(dead_until "$a")" '+%a %l:%M%p' 2>/dev/null) ($(awk '{print $2}' "$DEADDIR/$a"))"
      fi
      printf "%-10s %-7s %-9s %-22s %s\n" "$a" "$(weight_of "$a")" "${c:-0}" "$du" "$mark"
    done
    exit 0 ;;
  --pick)
    ranked "${2:-}" | head -1; exit 0 ;;
  --probe)
    [ -n "${2:-}" ] && is_account "$2" || die "--probe <account>"
    probe "$2"
    echo "$2 $PROBE_CLASS"
    [ "$PROBE_CLASS" = LIMIT ] && echo "dead until: $(date -r "$(dead_until "$2")" 2>/dev/null)"
    exit 0 ;;
  --add)
    name="${2:-}"; [ -n "$name" ] || die "--add <name>"
    [ -e "$ROOT/$name" ] && die "account '$name' already exists"
    mkdir -p "$ROOT/$name"
    for f in $LINKS; do
      [ -e "$HOME/.claude/$f" ] && ln -sfn "$HOME/.claude/$f" "$ROOT/$name/$f"
    done
    cp -p "$HOME/.claude/.claude.json" "$ROOT/$name/.claude.json" 2>/dev/null || true
    echo "baton: account '$name' created. Log it in:  baton $name   then /login"
    exit 0 ;;
  --dead)
    name="${2:-$(cat "$LAST" 2>/dev/null)}"; [ -n "$name" ] || die "--dead <name> (no last-used account)"
    is_account "$name" || die "no account '$name'"
    # die inside $() only exits the subshell, so the failure must be re-raised here
    dur=$(parse_duration "${3:-$DEFAULT_DEAD}") || exit 1
    mark_dead "$name" "$(( $(now) + dur ))" manual
    echo "baton: '$name' dead until $(date -r "$(( $(now) + dur ))")"
    exit 0 ;;
  --revive)
    [ -n "${2:-}" ] || die "--revive <name>"
    # is_account, not [ -d ]: this line deletes a path built from operator
    # input, so "../a" must never reach it.
    is_account "$2" || die "no account '$2'"
    rm -f "$DEADDIR/$2"; echo "baton: '$2' revived"; exit 0 ;;
  --reset)
    rm -f "$TALLY" "$LAST"; echo "baton: tallies reset"; exit 0 ;;
  --next)
    shift
    last=$(cat "$LAST" 2>/dev/null || true)
    if [ -n "$last" ]; then
      mark_dead "$last" "$(( $(now) + $(parse_duration $DEFAULT_DEAD) ))" next
      warn "marked '$last' dead for $DEFAULT_DEAD"
    fi
    auto_launch probe "$@" ;;
  --fast)
    shift
    auto_launch fast "$@" ;;
  --night)
    shift
    # runs.sh before lock.sh before watch.sh: the watcher records a receipt
    # the moment it has a pid and claims a session before resuming one, so
    # both the recorder and the arbiter have to be defined before the
    # launcher runs. lock -> runs is the only edge between the two.
    . "$SCRIPT_DIR/lib/runs.sh"
    . "$SCRIPT_DIR/lib/lock.sh"
    . "$SCRIPT_DIR/lib/watch.sh"
    night_mode "$@" ;;
  --pickup)
    # Read-only: what did the last session leave behind. Deliberately does
    # NOT source watch.sh -- pickup answers a question about dead runs and
    # must never be able to start one (the same forbidden direction QA-DOC
    # section 4 rule 5 draws for the existing flags). It also does NOT source
    # lock.sh: the evidence layer must keep working with no lock installed,
    # so the board can never come to depend on the claim layer (baton#2's
    # added acceptance).
    shift
    . "$SCRIPT_DIR/lib/pickup.sh"
    . "$SCRIPT_DIR/lib/runs.sh"
    runs_project
    exit $? ;;
  --lock-status)
    # What does the lock root say about one subject, and did it manage to
    # look? Exit 0 free-or-reclaimable, 1 held, 2 could-not-inspect. `inspected`
    # is printed because a caller that asserts "nothing is locked" without it
    # is asserting an absence it never established.
    shift
    [ -n "${1:-}" ] || die "--lock-status <subject>"
    . "$SCRIPT_DIR/lib/runs.sh"
    . "$SCRIPT_DIR/lib/lock.sh"
    lock_probe "$1"; lock_rc=$?
    printf 'subject=%s state=%s holder_pid=%s prov=%s inspected=%s\n' \
      "$1" "$LOCK_STATE" "${LOCK_HOLDER_PID:-}" "${LOCK_HOLDER_PROV:-}" "$LOCK_INSPECTED"
    exit "$lock_rc" ;;
  --claim)
    # The arbitration `--pickup` deliberately does not do. The board is a
    # projection and stays read-only; THIS is where two restarted
    # orchestrators find out that only one of them may act on it.
    #
    # The command to run is mandatory, and that is the design: a claim taken
    # by a process that immediately exits is stale the instant it is written,
    # so the claim and the work it guards are one invocation.
    shift
    [ -n "${1:-}" ] || die "--claim <subject> -- <command...>"
    lock_subject="$1"; shift
    . "$SCRIPT_DIR/lib/runs.sh"
    . "$SCRIPT_DIR/lib/lock.sh"
    lock_hold "$lock_subject" "$@"
    exit $? ;;
  --redispatch)
    # Redo a unit rather than adopt it: claim it, kill the matched orphan,
    # CONFIRM it is gone, and only then launch the replacement. Without the
    # confirmation this flag would be the duplicate baton#2 is about, with
    # the operator's blessing.
    shift
    [ -n "${1:-}" ] || die "--redispatch <unit> -- <command...>"
    lock_unit="$1"; shift
    . "$SCRIPT_DIR/lib/runs.sh"
    . "$SCRIPT_DIR/lib/lock.sh"
    lock_redispatch "$lock_unit" "$@"
    exit $? ;;
  *)
    [ ${#accounts[@]} -gt 0 ] || die "no accounts under $ROOT; run: baton --add <name>"
    if [ $# -ge 1 ] && is_account "$1"; then
      acct="$1"; shift
      is_dead "$acct" && warn "'$acct' is marked dead until $(date -r "$(dead_until "$acct")" 2>/dev/null) -- launching anyway (forced)"
      # baton#2 root cause 3: serialize login flows, one at a time, per
      # account. `baton <account>` IS baton's login flow -- it is the exact
      # command the not-logged-in handoff tells the operator to run, and two
      # of them running at once for one account is two OAuth refreshes
      # rotating each other's token, which is the shape of the 2026-08-25
      # auth cascade. Silent on success, so this path's stdout/stderr stay
      # byte-identical to the pre-failover script (scenario 12).
      #
      # The lock survives the `exec` below on purpose: exec keeps the pid and
      # the process start time, and pid+start-time is the identity lock.sh
      # matches on, so the claim stays valid for exactly as long as the
      # launched session lives and goes stale the moment it dies.
      . "$SCRIPT_DIR/lib/runs.sh"
      . "$SCRIPT_DIR/lib/lock.sh"
      lock_claim "login:$acct" || exit $?
      launch "$acct" "$@"
    else
      auto_launch probe "$@"
    fi ;;
esac
